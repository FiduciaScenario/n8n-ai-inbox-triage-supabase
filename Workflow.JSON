    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obsługa zarówno danych z body (POST), jak i płaskiego JSON-a testowego\nconst payload = $input.item.json.body || $input.item.json;\n\nconst rawEmail = (payload.sender_email || \"\").trim().toLowerCase();\nconst rawMessage = (payload.message || \"\").toString();\n\n// 1. Walidacja wejścia\nif (!rawEmail || !rawEmail.includes(\"@\")) {\n  throw new Error(\"Brak poprawnego adresu e-mail w payloadzie.\");\n}\n\n// 2. Czyszczenie tekstu z tagów HTML, nadmiarowych spacji i pustych linii (Regex)\nconst cleanMessage = rawMessage\n  .replace(/<[^>]*>?/gm, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\n// 3. Wyciągnięcie domeny i sprawdzenie, czy to domena firmowa\nconst freeProviders = [\"gmail.com\", \"wp.pl\", \"onet.pl\", \"o2.pl\", \"interia.pl\", \"yahoo.com\", \"outlook.com\", \"icloud.com\"];\nconst companyDomain = rawEmail.split(\"@\")[1] || \"\";\nconst isBusinessEmail = !freeProviders.includes(companyDomain);\n\n// 4. Deterministyczny hash (idempotencja pod kolumnę message_hash UNIQUE w Supabase)\nconst hashSource = `${rawEmail}|${cleanMessage.toLowerCase().slice(0, 200)}`;\nlet hash = 2166136261;\nfor (let i = 0; i < hashSource.length; i++) {\n  hash ^= hashSource.charCodeAt(i);\n  hash = Math.imul(hash, 16777619);\n}\nconst messageHash = \"lead_\" + (hash >>> 0).toString(16).padStart(8, \"0\");\n\nreturn {\n  json: {\n    message_hash: messageHash,\n    sender_email: rawEmail,\n    company_domain: companyDomain,\n    is_business_email: isBusinessEmail,\n    clean_message: cleanMessage,\n    received_at: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        16
      ],
      "id": "ddb2e941-9797-44a9-9ef0-fb56d9010457",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Przeanalizuj poniższą wiadomość przychodzącą od klienta B2B:\n\nNadawca: {{ $json.sender_email }}\nDomena: {{ $json.company_domain }} (Firmowy e-mail: {{ $json.is_business_email }})\nTreść wiadomości: {{ $json.clean_message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a B2B lead qualification engineer (AI Inbox Triage). Analyze the incoming message and return data strictly matching the JSON schema.  Rules: - intent: strictly one of \"sales_lead\", \"support\", or \"spam\". - lead_score: integer 0-100 (75-100 for businesses with a clear pain point, urgency, or budget; 0-30 for spam). - urgency: strictly \"high\", \"medium\", or \"low\". - detected_pain_point: 1 concise sentence in the sender's language describing the core business problem. - draft_reply: short, professional reply in the sender's language proposing a 15-minute demo."
            }
          ]
        },
        "batching": {}
      },
